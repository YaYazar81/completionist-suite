/* Completionist Pro -- Dark Slate & Emerald
 *
 * Gemeinsames Stylesheet fuer CompletionistMD und CompletionistPDF (und
 * CompletionistIMG). Die Platzhalter @name setzt core/design.py aus den
 * Design-Tokens ein (dunkles oder helles Thema); Farben deshalb nur hier
 * ueber Tokens, nicht als feste Werte.
 *
 * Bewusst nicht "QWidget { background: ... }": Das wuerde jedes Label in
 * einem Panel mit dem Fenstergrund uebermalen. Grundfarben kommen aus der
 * Palette (design.palette), das Stylesheet ergaenzt Rahmen, Radien und Zustaende.
 */

/* ------------------------------------------------------------ Grundflaechen */

QMainWindow, QDialog {
    background-color: @bg;
}

QToolTip {
    background-color: @panel;
    color: @text;
    border: 1px solid @accent;
    border-radius: 4px;
    padding: 4px 8px;
}

QSplitter::handle {
    background-color: @border;
}
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }

/* -------------------------------------------------------------- Toolbars */

QToolBar {
    background-color: @bg;
    border: none;
    border-bottom: 1px solid @border;
    padding: 3px 6px;
    spacing: 3px;
}

QToolBar::separator {
    background-color: @border;
    width: 1px;
    margin: 6px 5px;
}

/* --------------------------------------------- Werkzeug-Buttons (Icons) */

/* Idle: transparent, Icon gedaempft (Farbe setzt design.icon je Zustand) */
QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 6px;
    color: @muted;
}

QToolButton:hover {
    background-color: @hover;
    color: @bright;
}

QToolButton:pressed,
QToolButton:checked {
    background-color: @accent_bg;
    border-color: @accent;
    color: @accent_hi;
}

QToolButton:disabled {
    color: @disabled;
}

/* Text steht schon mit "▾" im Knopf; der zusaetzliche Pfeil waere doppelt */
QToolButton::menu-indicator {
    image: none;
    width: 0px;
}

/* ------------------------------------------------------- Push-Buttons */

QPushButton {
    background-color: @panel;
    border: 1px solid @border;
    border-radius: 6px;
    padding: 5px 12px;
    color: @text;
}

QPushButton:hover {
    background-color: @hover;
    border-color: @accent_hi;
    color: @bright;
}

QPushButton:pressed,
QPushButton:checked {
    background-color: @accent_bg;
    border-color: @accent;
    color: @accent_hi;
}

QPushButton:default {
    border-color: @accent;
}

QPushButton:disabled {
    background-color: @bg;
    border-color: @border;
    color: @disabled;
}

/* Uebergabe an die anderen Suite-Apps (► PDF, ► QR, ► IMG, ◀ Markdown):
 * ueberall derselbe abgesetzte Pro-Button mit Icon und Text. */
QToolButton#handoffButton,
QToolBar QToolButton[handoff="true"] {
    background-color: @panel;
    border: 1px solid @border;
    padding: 5px 10px;
    color: @text;
}

QToolButton#handoffButton:hover,
QToolBar QToolButton[handoff="true"]:hover {
    background-color: @hover;
    border-color: @accent_hi;
    color: @bright;
}

QToolButton#handoffButton:pressed,
QToolBar QToolButton[handoff="true"]:pressed {
    background-color: @accent_bg;
    border-color: @accent;
    color: @accent_hi;
}

/* -------------------------------------------------------- Eingabefelder */

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: @input;
    border: 1px solid @border;
    border-radius: 6px;
    padding: 4px 8px;
    color: @text;
    selection-background-color: @accent;
    selection-color: @bg;
}

QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover,
QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover {
    border-color: @border_hi;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid @accent;
}

QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    color: @disabled;
}

QSpinBox, QDoubleSpinBox {
    padding-right: 18px;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    width: 18px;
    border: none;
    background-color: transparent;
}
QSpinBox::up-button, QDoubleSpinBox::up-button { subcontrol-position: top right; }
QSpinBox::down-button, QDoubleSpinBox::down-button { subcontrol-position: bottom right; }

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: @hover;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url("@icons/chevron-up.svg");
    width: 12px;
    height: 12px;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url("@icons/chevron-down.svg");
    width: 12px;
    height: 12px;
}

QComboBox {
    padding-right: 24px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 22px;
    border: none;
}

QComboBox::down-arrow {
    image: url("@icons/chevron-down.svg");
    width: 14px;
    height: 14px;
}

QComboBox QAbstractItemView {
    background-color: @panel;
    border: 1px solid @border;
    selection-background-color: @accent_bg;
    selection-color: @accent_hi;
    outline: 0;
}

/* ------------------------------------------- Baeume, Listen, Container */

QTreeView, QListView, QTableView {
    background-color: @panel;
    alternate-background-color: @panel_alt;
    border: 1px solid @border;
    border-radius: 6px;
    padding: 4px;
    outline: 0;
}

QTreeView::item, QListView::item {
    padding: 4px 6px;
    border: 1px solid transparent;
    border-radius: 4px;
}

QTreeView::item:hover, QListView::item:hover {
    background-color: @hover;
    color: @bright;
}

QTreeView::item:selected, QListView::item:selected {
    background-color: @accent_bg;
    border-color: @accent;
    color: @accent_hi;
}

QHeaderView::section {
    background-color: @panel;
    color: @muted;
    border: none;
    border-bottom: 1px solid @border;
    padding: 4px 8px;
}

QGroupBox {
    background-color: @panel;
    border: 1px solid @border;
    border-radius: 6px;
    margin-top: 14px;
    padding: 10px 8px 8px 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: @muted;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

/* ------------------------------------------------------------- Tabs */

QTabWidget::pane {
    background-color: @panel;
    border: 1px solid @border;
    border-radius: 6px;
    top: -1px;
}

QTabBar::tab {
    background-color: @input;
    color: @muted;
    border: 1px solid @border;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 6px 12px;
    margin-right: 2px;
}

QTabBar::tab:hover:!selected {
    background-color: @hover;
    color: @bright;
}

QTabBar::tab:selected {
    background-color: @accent_bg;
    color: @accent_hi;
    border-color: @accent;
}

QTabBar::close-button {
    image: url("@icons/x.svg");
    subcontrol-position: right;
    border-radius: 4px;
    margin: 2px;
}

QTabBar::close-button:hover {
    background-color: @hover;
}

/* ----------------------------------------------------------- Menues */

QMenuBar {
    background-color: @bg;
    border-bottom: 1px solid @border;
}

QMenuBar::item {
    padding: 4px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: @hover;
}

QMenu {
    background-color: @panel;
    border: 1px solid @border;
    padding: 4px;
}

QMenu::item {
    padding: 5px 24px 5px 10px;
    border: 1px solid transparent;
    border-radius: 4px;
    color: @text;
}

QMenu::item:selected {
    background-color: @accent_bg;
    border-color: @accent;
    color: @accent_hi;
}

QMenu::item:disabled {
    color: @disabled;
}

QMenu::separator {
    height: 1px;
    background-color: @border;
    margin: 4px 6px;
}

/* ------------------------------------------------------ Scrollbalken */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background-color: @border;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar::handle:vertical { min-height: 28px; }
QScrollBar::handle:horizontal { min-width: 28px; }

QScrollBar::handle:hover {
    background-color: @muted;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}

/* ------------------------------------------------- Regler, Fortschritt */

QSlider::groove:horizontal {
    height: 4px;
    background-color: @border;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background-color: @accent;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background-color: @accent;
    width: 14px;
    margin: -6px 0;
    border-radius: 7px;
    border: 2px solid @bg;
}

QSlider::handle:horizontal:hover {
    background-color: @accent_hi;
}

QProgressBar {
    background-color: @input;
    border: 1px solid @border;
    border-radius: 6px;
    text-align: center;
    color: @text;
}

QProgressBar::chunk {
    background-color: @accent;
    border-radius: 5px;
}

/* -------------------------------------------------------- Statusleiste */

QStatusBar {
    background-color: @bg;
    border-top: 1px solid @border;
    color: @muted;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: @muted;
    padding: 0 8px;
}

QStatusBar QToolButton {
    padding: 2px 8px;
}

/* ================================================== App-spezifisch */

/* --- CompletionistPDF: Einstellungs-Sektionen (gui/widgets.py) --- */

QToolButton#sectionHeader {
    text-align: left;
    font-weight: 600;
    padding: 7px 6px;
    border: none;
    border-bottom: 1px solid @border;
    border-radius: 0;
    color: @text;
}

QToolButton#sectionHeader:hover {
    background-color: transparent;
    color: @accent_hi;
}

QToolButton#sectionHeader:checked {
    background-color: transparent;
    color: @accent_hi;
}

QFrame#sectionBody {
    border: none;
}

/* Viewer-Leiste ueber dem PDF (gui/pdf_file_view.py) */
QWidget#viewerBar {
    background-color: @bg;
    border-bottom: 1px solid @border;
}

/* --- CompletionistMD: Statusanzeige Speichern (mdeditor/window.py) --- */

QLabel#saveState[state="dirty"] { color: @warn; }
QLabel#saveState[state="saved"] { color: @accent_hi; }
QLabel#saveState[state="error"] { color: @danger; }

/* --- CompletionistMD: Vault-Explorer (mdeditor/vault.py) --- */

#vaultPanel {
    background-color: @panel;
    border-right: 1px solid @border;
}

QLabel#vaultTitle {
    font-weight: 600;
    padding: 2px 0;
    color: @text;
    background: transparent;
}

QLabel#vaultHint {
    color: @muted;
    padding: 6px 2px;
    background: transparent;
}

QFrame#vaultLine {
    color: @border;
    background-color: @border;
    border: none;
    max-height: 1px;
}

#vaultPanel QTreeView {
    border: none;
    border-radius: 0;
    background-color: @panel;
}

/* Smart-Bookmarks: entgratete Kacheln, aktiver Ordner in Smaragd */
QToolButton#bookmarkTile {
    background-color: @input;
    border: 1px solid @border;
    border-radius: 6px;
    padding: 4px 10px;
    color: @text;
}

QToolButton#bookmarkTile:hover {
    background-color: @hover;
    border-color: @accent_hi;
    color: @bright;
}

QToolButton#bookmarkTile:pressed,
QToolButton#bookmarkTile:checked {
    background-color: @accent_bg;
    border-color: @accent;
    color: @accent_hi;
}

/* Gliederung neben dem Editor (mdeditor/panels.py) */
#outlinePanel QTreeView, #outlinePanel QListView {
    border: none;
    border-radius: 0;
}
